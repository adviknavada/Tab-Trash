{
  "manifest_version": 3,
  "name": "Tab Trash",
  "version": "0.1.0",
  "description": "A 'recently deleted' for browser tabs.",
  "permissions": ["tabs", "storage", "alarms", "history"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Trash",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
  "flag-tab": {
    "suggested_key": { "default": "Alt+Shift+K" },
    "description": "Keep this tab: never filter it out of the trash"
  }
}
}